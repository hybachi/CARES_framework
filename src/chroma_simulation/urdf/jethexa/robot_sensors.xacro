=======
        <gz_frame_id>imu_link</gz_frame_id>
>>>>>>> d06e372 (implement jethexa controller)
      </sensor>
    </gazebo>

    <!-- Depth Camera -->
    <joint name="depth_camera_joint" type="fixed">
      <parent link="body_link"/> 
      <child link="depth_camera_link"/>
      <origin xyz="0.062455 0.0 0.07" rpy="0.0 0.0 0.0"/>
    </joint>
    <link name="depth_camera_link">
      <visual>
        <origin xyz="0.0 0.0 -0.015" rpy="0.0 0.0 ${my_pi/2}" />
        <geometry><mesh filename="package://chroma_simulation/models/jethexa/dabai.stl" scale="1.0 1.0 1.0"/></geometry>
        <material name=""><color rgba="0.8 0.8 0.8 1" /></material>
      </visual>

      <collision>
        <origin xyz="0.0 0.0 -0.01" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.02 0.08 0.02"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005" />
      </inertial>
    </link>

    <!-- Optical frames -->
    <link name="camera_depth_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-${my_pi/2} 0 -${my_pi/2}"/>
      <parent link="depth_camera_link"/>
      <child link="camera_depth_optical_frame"/>
    </joint>

    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="camera_depth_optical_frame"/>
      <child link="camera_color_optical_frame"/>
    </joint>

    <gazebo reference="depth_camera_link">
      <sensor name="depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera name="rgbd_camera">
          <horizontal_fov>1.0472</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>10</far></clip>
        </camera>
        <topic>/model/${model_name}/camera</topic>
