<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="jethexa_sensors" params="model_name">
    <xacro:property name="my_pi" value="3.1415926535897931"/>

    <!-- LiDAR -->
    <joint name="lidar_joint" type="fixed">
      <parent link="body_link"/>
      <child link="lidar_visual_link"/>
      <origin xyz="-0.023 0.0 0.1" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="lidar_visual_link">
      <visual>
        <origin xyz="0.0 0.0 -0.033" rpy="0.0 0.0 1.571" />
        <geometry><mesh filename="package://chroma_simulation/models/jethexa/g4.stl" scale="1.0 1.0 1.0"/></geometry>
        <material name=""><color rgba="0.2 0.2 0.2 1" /></material>
      </visual>
      
      <collision>
        <origin xyz="0.0 0.0 -0.015" rpy="0.0 0.0 0.0" />
        <geometry>
          <cylinder radius="0.035" length="0.025"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
      </inertial>
    </link>

    <gazebo reference="lidar_visual_link">
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
          </range>
        </lidar>
        <topic>/model/${model_name}/scan</topic>
<<<<<<< HEAD
        <gz_frame_id>${model_name}/lidar_visual_link</gz_frame_id>
=======
        <gz_frame_id>lidar_visual_link</gz_frame_id>
>>>>>>> d06e372 (implement jethexa controller)
      </sensor>
    </gazebo>

    <!-- IMU -->
    <joint name="imu_joint" type="fixed">
      <parent link="body_link"/>
      <child link="imu_link"/>
      <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
    </joint>
    <link name="imu_link">
      <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" /></inertial>
    </link>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <topic>/model/${model_name}/imu</topic>
<<<<<<< HEAD
