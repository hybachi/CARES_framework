<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="usar_arena">
    <!-- Essential Ignition Plugins -->
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <pbr><metal><albedo_color>0.8 0.8 0.8 1</albedo_color></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- PERIMETER WALLS (10x10 meters)             -->
    <!-- Height: 0.5m (allows top-down viewing)     -->
    <!-- ========================================== -->
    <model name="perimeter">
      <static>true</static>
      <!-- North Wall -->
      <link name="wall_n"><pose>0 5 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>10 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.1 0.5</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><pbr><metal><albedo_color>0.3 0.3 0.3 1</albedo_color></metal></pbr></material></visual>
      </link>
      <!-- South Wall -->
      <link name="wall_s"><pose>0 -5 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>10 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.1 0.5</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><pbr><metal><albedo_color>0.3 0.3 0.3 1</albedo_color></metal></pbr></material></visual>
      </link>
      <!-- East Wall -->
      <link name="wall_e"><pose>5 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 10 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 0.5</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><pbr><metal><albedo_color>0.3 0.3 0.3 1</albedo_color></metal></pbr></material></visual>
      </link>
      <!-- West Wall -->
      <link name="wall_w"><pose>-5 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 10 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 0.5</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><pbr><metal><albedo_color>0.3 0.3 0.3 1</albedo_color></metal></pbr></material></visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- ZONES (Ground overlays for visual cues)    -->
    <!-- PBR materials added so colors render       -->
    <!-- ========================================== -->
    <model name="floor_zones">
      <static>true</static>
      <!-- Safe Zone (Center, 2x10m area, Green) -->
      <link name="safe_zone"><pose>0 0 0.001 0 0 0</pose>
        <visual name="v"><geometry><box><size>2 10 0.002</size></box></geometry> 
          <material>
            <ambient>0.4 0.7 0.4 1</ambient><diffuse>0.4 0.7 0.4 1</diffuse>
            <pbr><metal><albedo_color>0.4 0.7 0.4 1</albedo_color></metal></pbr>
          </material>
        </visual>
      </link>
      
      <!-- Gravel Field (East, 4x10m area, Brown) -->
      <link name="gravel_zone"><pose>3 0 0.001 0 0 0</pose>
        <collision name="c"><geometry><box><size>4 10 0.002</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>4 10 0.002</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse>
            <pbr><metal><albedo_color>0.6 0.4 0.2 1</albedo_color></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- COLLAPSED BUILDING MAZE (West)             -->
    <!-- 0.6m clear corridors (Nav2 inflation safe) -->
    <!-- ========================================== -->
    <model name="building_maze">
      <static>true</static>

      <!-- Baffle 1 (X=-1.5) Entrance. 1.5m gap in the exact center -->
      <link name="baf1_top"><pose>-1.5 2.85 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 4.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.2 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><pbr><metal><albedo_color>0.6 0.6 0.6 1</albedo_color></metal></pbr></material>
        </visual>
      </link>
      <link name="baf1_bot"><pose>-1.5 -2.85 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 4.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 4.2 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><pbr><metal><albedo_color>0.6 0.6 0.6 1</albedo_color></metal></pbr></material>
        </visual>
      </link>

      <!-- Baffle 2 (X=-2.2) Gap at North (Y=4.6) -->
      <link name="baf2"><pose>-2.2 -0.35 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 9.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 9.2 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><pbr><metal><albedo_color>0.6 0.6 0.6 1</albedo_color></metal></pbr></material></visual>
      </link>

      <!-- Baffle 3 (X=-2.9) Gap at South (Y=-4.6) -->
      <link name="baf3"><pose>-2.9 0.35 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 9.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 9.2 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><pbr><metal><albedo_color>0.6 0.6 0.6 1</albedo_color></metal></pbr></material></visual>
      </link>

      <!-- Baffle 4 (X=-3.6) Gap at North (Y=4.6) -->
      <link name="baf4"><pose>-3.6 -0.35 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 9.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 9.2 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><pbr><metal><albedo_color>0.6 0.6 0.6 1</albedo_color></metal></pbr></material></visual>
      </link>

      <!-- Baffle 5 (X=-4.3) Gap at South (Y=-4.6) -->
      <!-- This leaves 0.6m clear space between it and the West wall (at -5) -->
      <link name="baf5"><pose>-4.3 0.35 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 9.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 9.2 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse><pbr><metal><albedo_color>0.6 0.6 0.6 1</albedo_color></metal></pbr></material></visual>
      </link>

    </model>
  </world>
</sdf>