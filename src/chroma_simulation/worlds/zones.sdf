<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="zones">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"></plugin>

    <!-- Sun & Ground -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <!-- ========================================================== -->
    <!-- ZONE 1: ROUGH TERRAIN -->
    <!-- ========================================================== -->
    <model name="zone_rough_terrain">
      <static>true</static>
      <pose>3.0 0 0 0 0 0</pose> 

      <!-- Base Floor -->
      <link name="base">
        <visual name="v_base">
          <geometry><box><size>4.0 4.0 0.001</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="c_base">
          <geometry><box><size>4.0 4.0 0.001</size></box></geometry>
        </collision>
      </link>

      <!-- Debris -->
      <link name="debris_1">
        <pose>0.5 0.5 0.1 0 0 0.5</pose>
        <visual name="v"><geometry><box><size>0.5 0.5 0.2</size></box></geometry>
        <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.5 0.5 0.2</size></box></geometry></collision>
      </link>
      <link name="debris_2">
        <pose>-0.8 -0.8 0.1 0 0 -0.2</pose>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0.4 0.2 0.0 1</ambient><diffuse>0.4 0.2 0.0 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.2</length></cylinder></geometry></collision>
      </link>

      <!-- ARUCO TAG 1 -->
      <link name="tag_1">
        <pose>1.5 0 0.2 0 0 0</pose> 
        <visual name="tag_visual">
          <geometry><box><size>0.02 0.1 0.1</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
                <metal>
                    <albedo_map>model://chroma_simulation/models/tags/id_0.png</albedo_map>
                </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========================================================== -->
    <!-- ZONE 2: NARROW PASSAGE -->
    <!-- ========================================================== -->
    <model name="zone_narrow_passage">
      <static>true</static>
      <!-- Rotated to point entrance towards center (0,0) -->
      <pose>-2 3.0 0 0 0 -0.785</pose> 

      <!-- Left Wall -->
      <link name="wall_left">
        <pose>0 0.6 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>4.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>4.0 0.2 1.0</size></box></geometry></collision>
      </link>

      <!-- Right Wall -->
      <link name="wall_right">
        <pose>0 -0.6 0.5 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>4.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>4.0 0.2 1.0</size></box></geometry></collision>
      </link>

      <!-- ARUCO TAG 2  -->
      <link name="tag_2">
        <pose>-1.95 0 0.2 0 0 0</pose> <!-- x=-1.95 is the far end of a 4.0m wall -->
        <visual name="tag_visual">
          <geometry><box><size>0.02 0.1 0.1</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
                <metal>
                    <albedo_map>model://chroma_simulation/models/tags/id_1.png</albedo_map>
                </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>


    <!-- ========================================================== -->
    <!-- ZONE 3: AERIAL PLATFORM  -->
    <!-- ========================================================== -->
    <model name="zone_aerial">
      <static>true</static>
      <pose>-2 -2 0 0 0 0</pose>

      <!-- The Tower -->
      <link name="tower">
        <pose>0 0 1.0 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>2.0 2.0 2.0</size></box></geometry>
          <material>
            <ambient>0.1 0.5 0.8 1</ambient>
            <diffuse>0.1 0.5 0.8 1</diffuse>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>2.0 2.0 2.0</size></box></geometry></collision>
      </link>

      <!-- ARUCO TAG 3  -->
      <link name="tag_3">
        <pose>0 0 2.005 0 0 0</pose>
        <visual name="tag_visual">
          <geometry><box><size>0.1 0.1 0.01</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
                <metal>
                    <albedo_map>model://chroma_simulation/models/tags/id_2.png</albedo_map>
                </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================== -->
    <!-- PERIMETER WALLS (ARENA BOUNDARIES)                         -->
    <!-- ========================================================== -->
    <model name="perimeter_walls">
      <static>true</static>
      
      <!-- North Wall -->
      <link name="north_wall">
        <pose>0 6.0 1.0 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>12.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>12.0 0.2 2.0</size></box></geometry></collision>
      </link>

      <!-- South Wall -->
      <link name="south_wall">
        <pose>0 -6.0 1.0 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>12.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>12.0 0.2 2.0</size></box></geometry></collision>
      </link>

      <!-- East Wall -->
      <link name="east_wall">
        <pose>6.0 0 1.0 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.2 12.0 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.2 12.0 2.0</size></box></geometry></collision>
      </link>

      <!-- West Wall -->
      <link name="west_wall">
        <pose>-6.0 0 1.0 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>0.2 12.0 2.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.2 12.0 2.0</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>