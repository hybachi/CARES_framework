<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chroma_bringup</name>
  <version>0.0.0</version>
  <description>Launch scripts, configurations, and maps for CHROMA deployments</description>
  <maintainer email="hiba2anwar@gmail.com">H.A. Sharif</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>chroma_core</exec_depend>
  <exec_depend>chroma_bridges</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
